<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Verify Your Account</title>
  </head>
  <body
    style="
      margin: 0;
      padding: 0;
      font-family: Arial, sans-serif;
      background-color: #f4f4f4;
    "
  >
    <table width="100%" border="0" cellspacing="0" cellpadding="0">
      <tr>
        <td align="center" style="padding: 20px 0">
          <table
            width="600"
            style="background-color: #ffffff; padding: 30px; border-radius: 8px"
          >
            <tr>
              <td style="text-align: center">
                <h1 style="color: #333">Welcome to <%= locals.appName %> 🎉</h1>
                <p style="color: #555; font-size: 16px">
                  Hi <%= locals.email %>, thanks for signing up! Please confirm
                  your account by clicking the button below.
                </p>
                <p style="margin: 30px 0">
                  <a
                    href="<%= locals.verifyUrl %>"
                    style="
                      background-color: #4caf50;
                      color: white;
                      padding: 12px 24px;
                      text-decoration: none;
                      border-radius: 6px;
                      font-size: 16px;
                    "
                  >
                    Verify Account
                  </a>
                </p>
                <p style="color: #888; font-size: 14px">
                  If you did not create this account, you can safely ignore this
                  email.
                </p>
                <p style="color: #888; font-size: 12px; margin-top: 40px">
                  &copy; <%= locals.year %> <%= locals.appName %>. All rights
                  reserved.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
